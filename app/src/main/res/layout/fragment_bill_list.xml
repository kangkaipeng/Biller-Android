<?xml version="1.0" encoding="utf-8"?>
<!--
    账单列表 Fragment 布局 (v4.1)
    模块: feature/biller/ui/main
    功能:
      1. 月份切换栏（◀ 2026年6月 ▶ + 支出合计）
      2. 搜索框 + 分类 ChipGroup 水平滚动
      3. RecyclerView + 空状态占位
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- ═══════════ 月份选择栏 — 点击弹出 DatePicker ═══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="0dp"
        android:paddingVertical="0dp">

        <!-- 月份标签 — 点击弹出月份选择器 -->
        <LinearLayout
            android:id="@+id/layout_month_selector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingVertical="6dp"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_month_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2026年6月"
                    android:textSize="18sp"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▾"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginStart="4dp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_month_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="支出 ¥0.00 | 共 0 笔"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

    </LinearLayout>

    <!-- ═══════════ 合并行: Chips(左) + 搜索图标+缩略(右) ═══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingVertical="4dp">

        <!-- 分类 Chips — 水平滚动占满剩余空间 -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="false" />
        </HorizontalScrollView>

    </LinearLayout>

    <!-- ═══════════ 渠道筛选行 (v5.1) — 标签 + Chip PopupMenu ═══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="渠道:"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:textColor="?attr/colorOutline"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_channel_selector"
            style="@style/Widget.Material3.Chip.Suggestion"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="全部渠道"
            android:clickable="true"
            android:checkable="false"
            app:chipIcon="@android:drawable/arrow_down_float"
            app:chipIconVisible="true"
            app:chipEndPadding="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 搜索图标 + 缩略文本 -->
        <LinearLayout
            android:id="@+id/layout_search_trigger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_search_toggle"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="搜索"
                android:clickable="false"
                app:icon="@android:drawable/ic_menu_search"
                app:iconSize="18dp"
                app:cornerRadius="16dp" />

            <!-- 搜索关键词缩略（默认隐藏） -->
            <TextView
                android:id="@+id/tv_search_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="?attr/colorOutline"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"
                android:layout_marginStart="2dp"
                tools:text="123..." />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══════════ 搜索框 — 默认隐藏，展开时显示在合并行下方 ═══════════ -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_search"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone"
        app:boxStrokeWidth="1dp"
        app:startIconDrawable="@android:drawable/ic_menu_search"
        app:endIconMode="clear_text"
        app:startIconScaleType="fitCenter"
        app:endIconScaleType="fitCenter"
        android:hint="搜索商户或备注...">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="6dp"
            android:textSize="14sp"
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionSearch"
            android:gravity="center_vertical" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="?attr/colorOutlineVariant" />

    <!-- ═══════════ 空状态占位 ═══════════ -->
    <TextView
        android:id="@+id/tv_empty_hint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="32dp"
        android:text="暂无捕获到的支付通知\n请确保已开启通知监听权限和无障碍服务"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOutline"
        android:visibility="visible" />

    <!-- ═══════════ 账单列表 ═══════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_bills"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:visibility="gone" />

</LinearLayout>
