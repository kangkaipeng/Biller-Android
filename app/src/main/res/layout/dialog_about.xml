<?xml version="1.0" encoding="utf-8"?>
<!--
    关于 BottomSheet 布局 (v4.1)
    模块: feature/biller/ui/about
    功能: 应用信息 + 隐私权限说明 + 保活指南占位
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="关于"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="16dp" />

        <!-- 应用信息 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="自动记账 v1.0\n基于通知+无障碍的双引擎自动化记账工具"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp" />

        <View android:layout_width="match_parent" android:layout_height="0.5dp"
            android:background="?attr/colorOutlineVariant" android:layout_marginBottom="16dp" />

        <!-- 隐私权限说明 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 隐私权限说明"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="8dp" />

        <!-- 通知监听权限 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 通知监听权限 (BIND_NOTIFICATION_LISTENER_SERVICE)"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="4dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="用于监听微信和支付宝的支付通知，自动提取交易金额和商户信息。当您完成支付后，通知栏会收到交易提醒，本应用通过解析该通知记录您的消费。"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="12dp" />

        <!-- 无障碍服务权限 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♿ 无障碍服务权限 (BIND_ACCESSIBILITY_SERVICE)"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="4dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="用于读取支付成功页面的界面内容，获取通知中缺失的商户名称、支付方式、原价和优惠信息等详细字段。该权限仅读取支付成功页面的界面文本内容，不执行任何自动操作。"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="12dp" />

        <!-- 通知发送权限 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔔 通知发送权限 (POST_NOTIFICATIONS, Android 13+)"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="4dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="用于在账单捕获成功时向您发送本地通知提醒。仅在 Android 13 及以上版本需要单独申请，您可以在系统设置中管理此权限。"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="16dp" />

        <View android:layout_width="match_parent" android:layout_height="0.5dp"
            android:background="?attr/colorOutlineVariant" android:layout_marginBottom="16dp" />

        <!-- 保活指南 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ 后台保活指南"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="4dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="内容完善中，敬请期待..."
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOutline" />

    </LinearLayout>
</ScrollView>
